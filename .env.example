# Mersennet explorer indexer — environment
# Copy to .env (or /opt/mersennet-indexer/.env) and fill in DB_PASS.

# Node JSON-RPC the indexer ingests from (HTTP endpoint):
RPC_URL=https://rpc.mersennet.com

# HTTP API bind port. Caddy reverse-proxies /api -> 127.0.0.1:PORT.
PORT=3334

# PostgreSQL connection (the indexer bootstraps its own tables on first run):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mersennet_explorer
DB_USER=mersennet
DB_PASS=change-me-to-a-strong-password

# Ingestion tuning (optional — defaults shown):
BATCH_SIZE=50
POLL_INTERVAL=3000
CONCURRENCY=10
